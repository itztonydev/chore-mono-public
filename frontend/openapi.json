lit Amount"}},"type":"object","required":["id","expense_id","user_id","split_amount"],"title":"ExpenseSplitResponse"},"GoogleAuthRequest":{"properties":{"credential_token":{"type":"string","title":"Credential Token","description":"Google ID Token or OAuth access token"},"email":{"anyOf":[{"type":"string","format":"email"},{"type":"null"}],"title":"Email","description":"Fallback email if validating in mock/dev mode"},"full_name":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Full Name","description":"Display name for Google user"},"target_user_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Target User Id","description":"Optional existing user UUID7 to attach Google auth to as an alternative login method"}},"type":"object","required":["credential_token"],"title":"GoogleAuthRequest"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"HouseholdCreate":{"properties":{"name":{"type":"string","maxLength":255,"minLength":1,"title":"Name","description":"Apartment or house title"}},"type":"object","required":["name"],"title":"HouseholdCreate"},"HouseholdMemberAdd":{"properties":{"user_id":{"type":"string","title":"User Id","description":"UUID7 ID of user to add"},"turn_order_index":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Turn Order Index","description":"Position index in circular queue"}},"type":"object","required":["user_id"],"title":"HouseholdMemberAdd"},"HouseholdMemberResponse":{"properties":{"id":{"type":"string","title":"Id"},"household_id":{"type":"string","title":"Household Id"},"user_id":{"type":"string","title":"User Id"},"turn_order_index":{"type":"integer","title":"Turn Order Index"},"user_full_name":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"User Full Name"},"user_email":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"User Email"}},"type":"object","required":["id","household_id","us