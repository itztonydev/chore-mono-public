o net balance (positive = owed money, negative = owes money)"},"user_names":{"additionalProperties":{"type":"string"},"type":"object","title":"User Names","description":"Hash table mapping user_id to user display name"},"is_balanced":{"type":"boolean","title":"Is Balanced"},"total_household_spend":{"type":"number","title":"Total Household Spend"}},"type":"object","required":["household_id","net_balances","is_balanced","total_household_spend"],"title":"BalancesResponse"},"ChoreCreate":{"properties":{"household_id":{"type":"string","title":"Household Id","description":"Target Household UUID7"},"title":{"type":"string","maxLength":255,"minLength":1,"title":"Title"},"description":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Description"},"initial_assignee_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Initial Assignee Id","description":"Optional starting member UUID7"}},"type":"object","required":["household_id","title"],"title":"ChoreCreate"},"ChoreResponse":{"properties":{"id":{"type":"string","title":"Id"},"household_id":{"type":"string","title":"Household Id"},"title":{"type":"string","title":"Title"},"description":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Description"},"current_assignee_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Current Assignee Id"},"current_assignee_name":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Current Assignee Name"},"created_at":{"type":"string","format":"date-time","title":"Created At"}},"type":"object","required":["id","household_id","title","created_at"],"title":"ChoreResponse"},"ChoreRotateRequest":{"properties":{"completed":{"type":"boolean","title":"Completed","description":"Whether current chore duty was satisfactorily completed","default":true},"skip_turn":{"type":"boolean","title":"Skip Turn","description":"Whether the assignee attempted to skip their turn","default":false},"notes":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Notes"}},"type":"object","title":"ChoreRo