son":{"schema":{"$ref":"#/components/schemas/HouseholdMemberResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/chores/":{"post":{"tags":["Chores & Circular Queue"],"summary":"Create Chore","description":"Create a new household chore and assign to starting roommate or circular queue head.","operationId":"create_chore_api_v1_chores__post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChoreCreate"}}},"required":true},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChoreResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/chores/{household_id}":{"get":{"tags":["Chores & Circular Queue"],"summary":"List Household Chores","description":"List all chores for a given household along with their current assignees.","operationId":"list_household_chores_api_v1_chores__household_id__get","parameters":[{"name":"household_id","in":"path","required":true,"schema":{"type":"string","title":"Household Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ChoreResponse"},"title":"Response List Household Chores Api V1 Chores  Household Id  Get"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/chores/{chore_id}/rotate":{"post":{"tags":["Chores & Circular Queue"],"summary":"Rotate Chore","description":"Circular Queue Turn Rotation:\n- Advances pointer to next member in fair rotation order.\n- If user attempts to skip turn or marks chore incomplete, fires a sarcastic alert.\n- Commits operation to persistent ActivityStackLog for undo support.","operationId":"rotate_chore_api_v1_chores__chore_id__rotate_post","parameters":[{"name":"chore_id","in":"path","required":true,"schema":{"type":"string","title":"Chore Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChoreRotateRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChoreRotateResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/expenses/":{"post":{"tags":["Expenses & Debt Simplification"],"summary":"Create Expense","description":"Create a shared expense and allocate splits across roommates.\nUses Hash Maps to track allocations and pushes mutation onto the Undo Stack.","operationId":"create_expense_api_v1_expenses__post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExpenseCreate"}}},"required":true},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExpenseResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/expenses/{household_id}/balances":{"get":{"tags":["Expenses & Debt Simplification"],"summary":"Get Household Balances","description":"Retrieve net balance vector using Hash Maps (Dictionaries).\nReturns net amount owed to or by each roommate.","operationId":"get_household_balances_api_v1_expenses__household_id__balances_get","parameters":[{"name":"household_id","in":"path","required":true,"schema":{"type":"string","title":"Household Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BalancesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/expenses/{household_id}/simplify":{"get":{"tags":["Expenses & Debt Simplification"],"summary":"Simplify Household Debts","description":"Min-Cash-Flow Greedy Directed Graph Algorithm.\nSimplifies multi-party debt vectors into minimal settlement transactions.","operationId":"simplify_household_debts_api_v1_expenses__household_id__simplify_get","parameters":[{"name":"household_id","in":"path","required":true,"schema":{"type":"string","title":"Household Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SimplifiedDebtResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/expenses/{household_id}/undo":{"post":{"tags":["Expenses & Debt Simplification"],"summary":"Undo Last Activity","description":"Undo Engine: Pops the top item from the activity stack log (LIFO)\nand executes reversing mutations in the database.","operationId":"undo_last_activity_api_v1_expenses__household_id__undo_post","parameters":[{"name":"household_id","in":"path","required":true,"schema":{"type":"string","title":"Household Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UndoResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/expenses/{household_id}/history":{"get":{"tags":["Expenses & Debt Simplification"],"summary":"List Expenses History","description":"List all recorded expenses and their splits for the household ledger.","operationId":"list_expenses_history_api_v1_expenses__household_id__history_get","parameters":[{"name":"household_id","in":"path","required":true,"schema":{"type":"string","title":"Household Id"}}],"responses":{"200":{"description":"Successful Response","content":{"applicat