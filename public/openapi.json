{
  "openapi": "3.1.0",
  "info": {
    "title": "Roommate Chore & Expense Roulette API",
    "version": "1.0.0",
    "description": "# 🎲 Roommate Chore & Expense Roulette API\n\nProduction-grade FastAPI backend featuring specialized Data Structures & Algorithms (DSA):\n- **Chore Rotation**: Circular Queue (Ring Buffer) with O(1) modulo turn shift and sarcastic alerts\n- **Expense Ledger**: Hash Tables with O(1) net balance computations and strict zero-sum conservation\n- **Debt Simplification**: Min-Cash-Flow Greedy Directed Graph Algorithm reducing O(N^2) debts to <= N - 1 vectors\n- **Activity Undo Stack**: LIFO Stack for idempotent database state reversal\n- **Identity & Keys**: RFC 9562 UUIDv7 monotonic primary keys and Ed25519 asymmetric cryptography",
    "contact": {
      "name": "Roulette Engineering Team",
      "email": "engineering@roommate-roulette.local",
      "url": "https://github.com/roommate-roulette"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.roommate-roulette.local",
      "description": "Production Gateway"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "JWT, Bcrypt, Google OAuth, and Ed25519 cryptographic logins"
    },
    {
      "name": "Households & Memberships",
      "description": "Household entity and circular queue turn indexing"
    },
    {
      "name": "Chores & Circular Queue",
      "description": "Deterministic turn rotation with sarcastic alerts"
    },
    {
      "name": "Expenses & Debt Simplification",
      "description": "Hash Table ledger, Min-Cash-Flow Graph algorithm, and Undo stack"
    },
    {
      "name": "Health",
      "description": "System liveness and readiness monitoring"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "System health check endpoint",
        "description": "Returns liveness status, active service identifier, and version.",
        "responses": {
          "200": {
            "description": "System is healthy and operational"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": ["Health"],
        "summary": "Root information index",
        "description": "Returns API overview, Swagger docs links, and list of implemented DSA features.",
        "responses": {
          "200": {
            "description": "Root metadata returned successfully"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register new user account",
        "description": "Generates an RFC 9562 UUIDv7 ID, hashes password with Bcrypt, and issues a signed PyJWT token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully and token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Email already registered"
          },
          "422": {
            "description": "Validation Error"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Bcrypt password login",
        "description": "Authenticates user email and password, issuing a signed PyJWT token with 7-day expiry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/google": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Google OAuth2 credential login",
        "description": "Validates Google OAuth JWT ID token and links or creates user account seamlessly.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleAuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Google authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/link-google": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Link Google Auth as alternative login method to existing account",
        "description": "Attaches Google OAuth2 credentials to an existing user account. Validates that the Google identity is not already linked to another roommate and returns a fresh JWT with updated IAM claims.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkGoogleAuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Google Auth linked successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkGoogleAuthResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - Google identity already linked to another account"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/v1/auth/unlink-google": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Unlink Google Auth from account (with lockout prevention)",
        "description": "Detaches Google login method from user account. Enforces lockout prevention: user must retain at least one alternative login method (password or Ed25519 key).",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnlinkGoogleAuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Google Auth unlinked successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMethodsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Lockout prevention error or no Google account linked"
          }
        }
      }
    },
    "/api/v1/auth/methods/{user_id}": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Query configured authentication methods for roommate",
        "description": "Returns active authentication strategies: password, ed25519, and google auth.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "description": "User UUID7",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authentication methods retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMethodsResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/v1/auth/ed25519-challenge": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Request Ed25519 cryptographic challenge",
        "description": "Generates a high-entropy 32-byte CSPRNG challenge nonce with a 300-second TTL.",
        "responses": {
          "200": {
            "description": "Challenge nonce generated"
          }
        }
      }
    },
    "/api/v1/auth/ed25519-login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Ed25519 cryptographic signature login",
        "description": "Verifies a 64-byte Ed25519 Edwards-curve signature against the public key and server challenge nonce.",
        "responses": {
          "200": {
            "description": "Cryptographic signature verified and JWT issued"
          },
          "401": {
            "description": "Invalid cryptographic signature"
          }
        }
      }
    },
    "/api/v1/households/": {
      "post": {
        "tags": ["Households & Memberships"],
        "summary": "Create a household entity",
        "description": "Creates an apartment or communal living entity with an RFC 9562 UUIDv7 primary key.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "201": {
            "description": "Household created"
          }
        }
      }
    },
    "/api/v1/households/{household_id}": {
      "get": {
        "tags": ["Households & Memberships"],
        "summary": "Get household by UUID7",
        "description": "Retrieves household entity and registered members with their turn queue indices.",
        "parameters": [
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Household retrieved"
          },
          "404": {
            "description": "Household not found"
          }
        }
      }
    },
    "/api/v1/households/{household_id}/members": {
      "post": {
        "tags": ["Households & Memberships"],
        "summary": "Register roommate into circular queue",
        "description": "Registers a user into the household circular ring buffer, assigning their deterministic turn order index.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "201": {
            "description": "Member added to circular queue"
          }
        }
      }
    },
    "/api/v1/chores/{household_id}": {
      "get": {
        "tags": ["Chores & Circular Queue"],
        "summary": "List household chores & active assignees",
        "description": "Returns all chores for the household along with current circular queue pointer assignees.",
        "parameters": [
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of household chores"
          }
        }
      }
    },
    "/api/v1/chores/": {
      "post": {
        "tags": ["Chores & Circular Queue"],
        "summary": "Create chore assigned to circular queue head",
        "description": "Registers a new chore duty and initializes its pointer at the head of the circular queue.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "201": {
            "description": "Chore successfully created"
          }
        }
      }
    },
    "/api/v1/chores/{chore_id}/rotate": {
      "post": {
        "tags": ["Chores & Circular Queue"],
        "summary": "Rotate circular queue pointer to next roommate O(1)",
        "description": "Executes O(1) turn shift via `(current_index + 1) % N`. Triggers dynamic Sarcastic Alert if user attempts to skip.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "chore_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Queue rotated successfully"
          },
          "400": {
            "description": "Premature skip with Sarcastic Alert"
          }
        }
      }
    },
    "/api/v1/expenses/": {
      "post": {
        "tags": ["Expenses & Debt Simplification"],
        "summary": "Record shared expense & splits into Hash Table ledger",
        "description": "Records an expense, tabulates individual participant splits, and pushes a mutation frame onto the LIFO activity undo stack.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "201": {
            "description": "Expense logged successfully"
          },
          "400": {
            "description": "Invalid splits sum"
          }
        }
      }
    },
    "/api/v1/expenses/{household_id}/balances": {
      "get": {
        "tags": ["Expenses & Debt Simplification"],
        "summary": "Compute Hash Table net balance vector O(1)",
        "description": "Returns O(1) net balance dictionary where positive represents money owed to user and negative represents money user owes. Guarantees sum of balances = 0.",
        "parameters": [
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Net balances tabulated"
          }
        }
      }
    },
    "/api/v1/expenses/{household_id}/simplify": {
      "get": {
        "tags": ["Expenses & Debt Simplification"],
        "summary": "Execute Min-Cash-Flow Directed Graph Debt Simplification",
        "description": "Executes greedy bipartite matching algorithm to compress multi-party debt webs into at most N - 1 minimal settlement transactions.",
        "parameters": [
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Debt graph simplified"
          }
        }
      }
    },
    "/api/v1/expenses/{household_id}/undo": {
      "post": {
        "tags": ["Expenses & Debt Simplification"],
        "summary": "Pop and undo top mutation from Activity Stack (LIFO)",
        "description": "Pops top record from ActivityStackLog and idempotently reverses the database state.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Mutation successfully undone"
          },
          "400": {
            "description": "Stack Underflow error with Sarcastic Alert"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "PyJWT Bearer token"
      },
      "Ed25519Signature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Ed25519-Signature",
        "description": "64-byte Ed25519 signature over server challenge nonce"
      },
      "Ed25519PublicKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Ed25519-Public-Key",
        "description": "32-byte Ed25519 hex public key"
      }
    },
    "schemas": {
      "UserRegisterRequest": {
        "title": "UserRegisterRequest",
        "type": "object",
        "required": ["email", "password", "full_name"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 },
          "full_name": { "type": "string" },
          "ed25519_public_key": { "type": "string" }
        }
      },
      "UserLoginRequest": {
        "title": "UserLoginRequest",
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "TokenResponse": {
        "title": "TokenResponse",
        "type": "object",
        "required": ["access_token", "token_type", "user_id", "email", "full_name"],
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "default": "bearer" },
          "user_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "full_name": { "type": "string" },
          "google_sub_id": { "type": "string" },
          "available_login_methods": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "GoogleAuthRequest": {
        "title": "GoogleAuthRequest",
        "type": "object",
        "required": ["credential_token"],
        "properties": {
          "credential_token": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "full_name": { "type": "string" },
          "target_user_id": { "type": "string", "format": "uuid" }
        }
      },
      "LinkGoogleAuthRequest": {
        "title": "LinkGoogleAuthRequest",
        "type": "object",
        "required": ["credential_token"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "credential_token": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "full_name": { "type": "string" }
        }
      },
      "LinkGoogleAuthResponse": {
        "title": "LinkGoogleAuthResponse",
        "type": "object",
        "required": ["status", "message", "user_id", "email", "full_name", "google_sub_id", "available_login_methods", "access_token", "token_type"],
        "properties": {
          "status": { "type": "string" },
          "message": { "type": "string" },
          "user_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "full_name": { "type": "string" },
          "google_sub_id": { "type": "string" },
          "available_login_methods": {
            "type": "array",
            "items": { "type": "string" }
          },
          "access_token": { "type": "string" },
          "token_type": { "type": "string" }
        }
      },
      "UnlinkGoogleAuthRequest": {
        "title": "UnlinkGoogleAuthRequest",
        "type": "object",
        "properties": {
          "user_id": { "type": "string", "format": "uuid" }
        }
      },
      "AuthMethodsResponse": {
        "title": "AuthMethodsResponse",
        "type": "object",
        "required": ["user_id", "email", "full_name", "has_password", "has_ed25519", "has_google_auth", "available_login_methods"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "full_name": { "type": "string" },
          "has_password": { "type": "boolean" },
          "has_ed25519": { "type": "boolean" },
          "ed25519_public_key": { "type": "string" },
          "has_google_auth": { "type": "boolean" },
          "google_sub_id": { "type": "string" },
          "available_login_methods": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
